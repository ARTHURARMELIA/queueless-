# QUEUELESS Environment Configuration

# Supabase Realtime & PostgreSQL Database (Optional for Production; Demo mode runs out of the box)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp Business Cloud API Gateway (Meta Graph API)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token

# OTP & Verification Provider (Twilio / MessageBird / Firebase Auth)
OTP_PROVIDER=simulated_demo
OTP_EXPIRATION_SECONDS=300

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
